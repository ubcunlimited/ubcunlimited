# UBC Unlimited — environment variables
# The PUBLIC marketing site runs with NONE of these set. They enable optional
# backend features (phase 2). Copy to .env for local dev; set in Railway for prod.

# Server port (Railway provides this automatically; defaults to 3000 locally)
# PORT=3000

# --- Database (optional): leads/testimonials persistence via Drizzle/MySQL ---
# Without this, forms still submit and are logged, but nothing is stored in a DB.
# DATABASE_URL=mysql://user:password@host:3306/dbname

# --- Google reCAPTCHA v3 (optional): bot protection on forms ---
# RECAPTCHA_SECRET_KEY=6Lxxxxxxxxxxxxxxxxxxxxxx

# --- Agent portal password (optional): gates /agent-iso ---
# AGENT_PORTAL_PASSWORD=changeme

# --- SEMrush (optional, owner-only SEO tools) ---
# SEMRUSH_API_KEY=xxxxxxxx

# NOTE: The following legacy keys are no longer used (Manus platform removed):
#   VITE_APP_ID, JWT_SECRET, OAUTH_SERVER_URL, OWNER_OPEN_ID,
#   BUILT_IN_FORGE_API_URL, BUILT_IN_FORGE_API_KEY
